# Lives in api/ (not only the repo root) so it also applies inside the API's
# Docker build context, which contains just this folder.

# EF Core writes these; analyzers and style rules don't apply to generated migrations.
[src/**/Migrations/*.cs]
generated_code = true

[*.cs]
# CA1716 protects libraries consumed from other .NET languages (here, VB's
# `Event` keyword). This is an application written only in C#, and "Event"
# is the domain's own word, so the rule doesn't apply.
dotnet_diagnostic.CA1716.severity = none
